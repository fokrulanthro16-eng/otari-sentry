# ==============================================================================
# otari-sentry Environment Configuration
# ==============================================================================

# Application Metadata
PROJECT_NAME="otari-sentry"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false

# Server Bindings
HOST="0.0.0.0"
PORT=8000
WORKERS=1

# Mozilla Otari Gateway Credentials & Endpoints
OTARI_BASE_URL="https://otari.ai/api/v1"
OTARI_API_KEY=""

# Model Routing Configuration
PRIMARY_MODEL="alibaba/qwen-3.5-35b-a3b"
FALLBACK_MODEL="meta-llama/llama-3.3-70b-instruct"

# SLA Timeouts & Retry Limits
PRIMARY_TIMEOUT_SECONDS=30.0
FALLBACK_TIMEOUT_SECONDS=35.0
MAX_RETRIES=2

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIME_SECONDS=30.0

# Airlock Deterministic Security Guardrails
AIRLOCK_ENABLED=true
AIRLOCK_MAX_PROMPT_LENGTH=16384
AIRLOCK_MAX_TOTAL_TOKENS_ESTIMATE=8192
AIRLOCK_STRICT_CREDENTIAL_CHECK=true
AIRLOCK_STRICT_SQL_CHECK=true
AIRLOCK_STRICT_JAILBREAK_CHECK=true

# Telemetry & Observability
SERVICE_NAME="otari-sentry"
SERVICE_VERSION="1.0.0"
SIMULATE_W3C_BAGGAGE=true
